APP_NAME=CicleVibes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ===== MySQL con TLS/SSL (p. ej. Aiven) =====
# Estas variables NO se definen en .env ni en el repositorio. En Render se
# inyectan como variables de entorno secretas. docker-entrypoint.sh escribe el
# contenido de MYSQL_SSL_CA en un fichero temporal y configura MYSQL_ATTR_SSL_CA
# automáticamente. Localmente se omiten para que la conexión siga funcionando.
# MYSQL_ATTR_SSL_CA=                  # (la gestiona docker-entrypoint.sh)
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ================= Mapas (Leaflet + OpenStreetMap) =================
# Proveedor de mapas. Solo se usa "openstreetmap" por ahora.
MAP_PROVIDER=openstreetmap

# Centro y zoom por defecto del mapa (Barranquilla, Colombia)
MAP_DEFAULT_LAT=10.9871
MAP_DEFAULT_LNG=-74.7890
MAP_DEFAULT_ZOOM=13

# Tiles de OpenStreetMap (URL de tiles pï¿½blicos) y atribuciï¿½n
MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_MAX_ZOOM=19

# Nominatim (geocodificaciï¿½n). Respeta la polï¿½tica de uso pï¿½blica:
# mï¿½ximo 1 peticiï¿½n/segundo, sin peticiones por cada tecla, con User-Agent.
MAP_NOMINATIM_URL=https://nominatim.openstreetmap.org
MAP_USER_AGENT="CicleVibes/1.0 (mapa de rutas para bicicletas)"
MAP_SEARCH_LIMIT=6

# OSRM (cï¿½lculo de rutas). Perfil orientado a bicicleta si el servidor lo soporta.
MAP_OSRM_URL=http://router.project-osrm.org
MAP_OSRM_PROFILE=cycling
MAP_OSRM_ALTERNATIVES=2
MAP_ROUTING_DRIVER=osrm
MAP_GRAPHHOPPER_URL=https://graphhopper.com/api/1
MAP_GRAPHHOPPER_KEY=
MAP_GRAPHHOPPER_PROFILE=bike
MAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_OVERPASS_TIMEOUT=25
MAP_ALTERNATIVES_COUNT=3

# Lï¿½mite de marcadores de bicicletas por peticiï¿½n.
MAP_BICICLETAS_LIMIT=100

MAP_CICLORUTAS_GEOJSON=ciclorutas-barranquilla.geojson
# Ruta que prioriza ciclorrutas (CiclorutaService + OSRM para accesos)
# Desvación máxima aceptada respecto a la ruta directa (1.5 = hasta 50% más larga).
BIKE_ROUTE_MAX_DETOUR=1.5
# Cobertura mínima sobre ciclorrutas (0.10 = 10%).
BIKE_ROUTE_MIN_CICLORUTA_COVERAGE=0.25
# Fuerza de la preferencia ciclista al ordenar alternativas (0..1).
BIKE_ROUTE_CYCLE_PREF=0.5
# Hueco máximo (m) entre componentes de la red para encadenar rutas con OSRM.
BIKE_ROUTE_MAX_GAP_M=3000
# Tolerancia lateral (m) para puntuar la cobertura de una ruta.
CICLORUTAS_MATCH_TOLERANCE_M=30
CICLORUTAS_NODE_JOIN_TOLERANCE_M=20
CICLORUTAS_JOIN_SUSPICIOUS_TOLERANCE_M=50
# Velocidad media para estimar tiempo sobre la red de ciclorrutas (km/h).
BIKE_AVG_SPEED_KMH=15
# Velocidad máxima coherente (km/h) para una bici en ciudad; por encima de
# ella, la duración de OSRM se recalcula desde la distancia real.
BIKE_ROUTE_MAX_EXPECTED_SPEED_KMH=25
