APP_NAME=CicleVibes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ===== MySQL con TLS/SSL (p. ej. Aiven) =====
# Estas variables NO se definen en .env ni en el repositorio. En Render se
# inyectan como variables de entorno secretas. docker-entrypoint.sh escribe el
# contenido de MYSQL_SSL_CA en un fichero temporal y configura MYSQL_ATTR_SSL_CA
# automáticamente. Localmente se omiten para que la conexión siga funcionando.
# MYSQL_ATTR_SSL_CA=                  # (la gestiona docker-entrypoint.sh)
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Para desarrollo local los correos se escriben en el log (MAIL_MAILER=log),
# así el flujo de recuperación funciona sin servidor SMTP.
#
# Para producción se recomienda SMTP con cualquier proveedor (Gmail, Outlook,
# Hotmail, Yahoo, iCloud, ...) descomentando las líneas de abajo y usando una
# contraseña de aplicación / credenciales de servicio. Ejemplos de servidores:
#   - Gmail:         smtp.gmail.com:587          (TLS, AUTH)
#   - Outlook/Hotmail:smtp.office365.com:587     (TLS, AUTH)
#   - Yahoo:         smtp.mail.yahoo.com:587     (TLS, AUTH)
#   - iCloud:        smtp.mail.me.com:587        (TLS, AUTH)
# NOTA: el usuario final usa su propio proveedor de correo; CicleVibes solo
# envía el mensaje a la dirección registrada (sin detectar proveedores).
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@midominio.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

# ===== "Continuar con Google" (OAuth 2.0 / OpenID Connect) =====
# Credenciales OAuth reales. Se crean en Google Cloud Console →
# "APIs y servicios / Credenciales" → "Crear credenciales / ID de cliente
# OAuth". La URI de redirección autorizada debe coincidir exactamente con
# GOOGLE_REDIRECT_URI. NO comprometer estos valores en el repositorio;
# se inyectan como variables secretas en producción (p. ej. en Render).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

VITE_APP_NAME="${APP_NAME}"

# ================= Mapas (Leaflet + OpenStreetMap) =================
# Proveedor de mapas. Por defecto se usan tiles oscuros de Stadia Maps
# (alidade_smooth_dark) para integrarse con el tema dark de la aplicación.
# No requieren API key para desarrollo local ni para uso no comercial de
# bajo volumen; para producción con key gratuita basta añadir
# "?api_key=TU_KEY" al final de MAP_TILES_URL (ver https://stadiamaps.com).
MAP_PROVIDER=stadia

# Centro y zoom por defecto del mapa (Barranquilla, Colombia)
MAP_DEFAULT_LAT=10.9871
MAP_DEFAULT_LNG=-74.7890
MAP_DEFAULT_ZOOM=13

# Tiles oscuros de Stadia Maps (Alidade Smooth Dark) y atribución requerida
MAP_TILES_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION='&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
MAP_TILES_MAX_ZOOM=19

# Nominatim (geocodificaciï¿½n). Respeta la polï¿½tica de uso pï¿½blica:
# mï¿½ximo 1 peticiï¿½n/segundo, sin peticiones por cada tecla, con User-Agent.
MAP_NOMINATIM_URL=https://nominatim.openstreetmap.org
MAP_USER_AGENT="CicleVibes/1.0 (mapa de rutas para bicicletas)"
MAP_SEARCH_LIMIT=6

# OSRM (cï¿½lculo de rutas). Perfil orientado a bicicleta si el servidor lo soporta.
MAP_OSRM_URL=http://router.project-osrm.org
MAP_OSRM_PROFILE=cycling
MAP_OSRM_ALTERNATIVES=2
MAP_ROUTING_DRIVER=osrm
MAP_GRAPHHOPPER_URL=https://graphhopper.com/api/1
MAP_GRAPHHOPPER_KEY=
MAP_GRAPHHOPPER_PROFILE=bike
MAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_OVERPASS_TIMEOUT=25
MAP_ALTERNATIVES_COUNT=3

# Lï¿½mite de marcadores de bicicletas por peticiï¿½n.
MAP_BICICLETAS_LIMIT=100

MAP_CICLORUTAS_GEOJSON=ciclorutas-barranquilla.geojson
# Ruta que prioriza ciclorrutas (CiclorutaService + OSRM para accesos)
# Desvación máxima aceptada respecto a la ruta directa (1.5 = hasta 50% más larga).
BIKE_ROUTE_MAX_DETOUR=1.5
# Cobertura mínima sobre ciclorrutas (0.10 = 10%).
BIKE_ROUTE_MIN_CICLORUTA_COVERAGE=0.25
# Fuerza de la preferencia ciclista al ordenar alternativas (0..1).
BIKE_ROUTE_CYCLE_PREF=0.5
# Hueco máximo (m) entre componentes de la red para encadenar rutas con OSRM.
BIKE_ROUTE_MAX_GAP_M=3000
# Tolerancia lateral (m) para puntuar la cobertura de una ruta.
CICLORUTAS_MATCH_TOLERANCE_M=30
CICLORUTAS_NODE_JOIN_TOLERANCE_M=20
CICLORUTAS_JOIN_SUSPICIOUS_TOLERANCE_M=50
# Velocidad media para estimar tiempo sobre la red de ciclorrutas (km/h).
BIKE_AVG_SPEED_KMH=15
# Velocidad máxima coherente (km/h) para una bici en ciudad; por encima de
# ella, la duración de OSRM se recalcula desde la distancia real.
BIKE_ROUTE_MAX_EXPECTED_SPEED_KMH=25
